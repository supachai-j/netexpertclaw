{
  "mcpServers": {
    "subnet-calc": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--no-project",
        "--isolated",
        "--with",
        "mcp==1.30.0",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp/subnet-calc/server.py"
      ],
      "env": {}
    },
    "fwrule": {
      "command": "python3",
      "env": {},
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/fwrule/proxy.py",
        "--cache",
        "${CLAUDE_PLUGIN_ROOT}/mcp/fwrule/tools.cache.json",
        "--",
        "uv",
        "run",
        "--quiet",
        "--no-project",
        "--isolated",
        "--with-requirements",
        "${CLAUDE_PLUGIN_ROOT}/mcp/fwrule/requirements.txt",
        "--with",
        "git+https://github.com/AutomateIP/fwrule-mcp@3bd52d79919b0aa5124e5d34fcbb12fb6112accd",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp/fwrule/launch.py"
      ]
    },
    "rfc-lookup": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--no-project",
        "--isolated",
        "--with",
        "mcp==1.30.0",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp/rfc-lookup/server.py"
      ],
      "env": {}
    },
    "eve-lab": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--no-project",
        "--isolated",
        "--with",
        "mcp==1.30.0",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp/eve-lab/server.py"
      ],
      "env": {}
    },
    "wikipedia": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--no-project",
        "--isolated",
        "--with",
        "mcp==1.30.0",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp/wikipedia/server.py"
      ],
      "env": {}
    }
  }
}
