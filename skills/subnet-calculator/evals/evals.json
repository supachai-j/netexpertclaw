{
  "skill_name": "subnet-calculator",
  "evals": [
    {
      "id": 1,
      "prompt": "I have 10.20.0.0/24 to split between a user LAN needing 100 hosts, a server LAN needing 50, and a management LAN needing 10. Give me a VLSM plan with gateways.",
      "expected_output": "A table with three non-overlapping subnets taken from 10.20.0.0/24 (/25, /26, /28 or tighter), each with network, prefix, usable host count and gateway = first usable host, values taken from the tool.",
      "assertions": [
        "Three subnets are listed and none overlap",
        "Each subnet has enough usable hosts for its requirement",
        "The prefix lengths are /25, /26 and /28 (or a justified tighter fit)",
        "Every subnet lies inside 10.20.0.0/24",
        "Gateway is stated as the first usable host and the assumption is named"
      ],
      "checks": [
        {
          "type": "vlsm",
          "parent": "10.20.0.0/24",
          "need": [
            100,
            50,
            10
          ],
          "label": "VLSM plan valid"
        }
      ]
    },
    {
      "id": 2,
      "prompt": "what's the ACL wildcard for 192.0.2.64/26 and how many hosts can I use?",
      "expected_output": "Wildcard 0.0.0.63 and 62 usable hosts.",
      "assertions": [
        "States wildcard 0.0.0.63",
        "States 62 usable hosts"
      ],
      "checks": [
        {
          "type": "regex",
          "pattern": "0\\.0\\.0\\.63\\b",
          "label": "wildcard 0.0.0.63"
        },
        {
          "type": "regex",
          "pattern": "\\b62\\b",
          "label": "62 usable hosts"
        }
      ]
    },
    {
      "id": 3,
      "prompt": "Calculate 192.0.2.5/24 for me",
      "expected_output": "The tool rejects host bits; the answer explains the canonical network 192.0.2.0/24 and then reports its values.",
      "assertions": [
        "Does not silently compute for the host address",
        "Mentions the corrected network 192.0.2.0/24",
        "Reports 254 usable hosts after correction"
      ],
      "checks": [
        {
          "type": "regex",
          "pattern": "192\\.0\\.2\\.0/24",
          "label": "corrected network"
        },
        {
          "type": "regex",
          "pattern": "\\b254\\b",
          "label": "254 usable hosts"
        }
      ]
    },
    {
      "id": 4,
      "prompt": "What is the next /27 after 10.1.7.64/27, and how many usable hosts does it have?",
      "expected_output": "10.1.7.96/27 with 30 usable hosts.",
      "assertions": [
        "Next subnet is 10.1.7.96/27",
        "30 usable hosts"
      ],
      "checks": [
        {
          "type": "regex",
          "pattern": "10\\.1\\.7\\.96/27",
          "label": "10.1.7.96/27"
        },
        {
          "type": "regex",
          "pattern": "\\b30\\b",
          "label": "30 hosts"
        }
      ]
    },
    {
      "id": 5,
      "prompt": "How many /64 subnets fit in 2001:db8:ab00::/52, and what is the last one?",
      "expected_output": "4096 subnets; last is 2001:db8:ab00:fff::/64.",
      "assertions": [
        "Count is 4096",
        "Last /64 is 2001:db8:ab00:fff::/64"
      ],
      "checks": [
        {
          "type": "regex",
          "pattern": "\\b4096\\b",
          "label": "4096"
        },
        {
          "type": "regex",
          "pattern": "2001:db8:ab00:0*fff::/64",
          "label": "last /64"
        }
      ]
    },
    {
      "id": 6,
      "prompt": "Are 10.64.0.10 and 10.127.255.1 inside the same 10.64.0.0/10 block, and how many usable hosts does that /10 have?",
      "expected_output": "Yes, both inside; 4194302 usable hosts.",
      "assertions": [
        "Says both addresses are inside 10.64.0.0/10",
        "4194302 usable hosts"
      ],
      "checks": [
        {
          "type": "regex",
          "pattern": "\\b4194302\\b",
          "label": "4194302 hosts"
        },
        {
          "type": "not_regex",
          "pattern": "\\bnot (in|inside|within) the same",
          "label": "does not deny membership"
        }
      ]
    }
  ]
}
