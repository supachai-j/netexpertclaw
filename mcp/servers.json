{
  "subnet-calc": {
    "command": "uv",
    "args": [
      "run",
      "--quiet",
      "--no-project",
      "--isolated",
      "--with",
      "mcp==1.30.0",
      "python",
      "{root}/mcp/subnet-calc/server.py"
    ],
    "env": {},
    "capability": "read"
  },
  "fwrule": {
    "command": "python3",
    "capability": "read",
    "env": {},
    "args": [
      "{root}/mcp/fwrule/proxy.py",
      "--cache",
      "{root}/mcp/fwrule/tools.cache.json",
      "--",
      "uv",
      "run",
      "--quiet",
      "--no-project",
      "--isolated",
      "--with-requirements",
      "{root}/mcp/fwrule/requirements.txt",
      "--with",
      "git+https://github.com/AutomateIP/fwrule-mcp@3bd52d79919b0aa5124e5d34fcbb12fb6112accd",
      "python",
      "{root}/mcp/fwrule/launch.py"
    ]
  },
  "rfc-lookup": {
    "command": "uv",
    "args": [
      "run",
      "--quiet",
      "--no-project",
      "--isolated",
      "--with",
      "mcp==1.30.0",
      "python",
      "{root}/mcp/rfc-lookup/server.py"
    ],
    "env": {},
    "capability": "read",
    "egress": [
      "www.rfc-editor.org"
    ]
  },
  "eve-lab": {
    "command": "uv",
    "args": [
      "run",
      "--quiet",
      "--no-project",
      "--isolated",
      "--with",
      "mcp==1.30.0",
      "python",
      "{root}/mcp/eve-lab/server.py"
    ],
    "env": {},
    "capability": "read",
    "egress": []
  }
}
